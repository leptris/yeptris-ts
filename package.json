{
  "name": "yeptris",
  "version": "0.6.61",
  "description": "YAML for JavaScript at libyeptris speed (WebAssembly, no fallback)",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "node --test test/test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leptris/yeptris-ts.git"
  },
  "bugs": {
    "url": "https://github.com/leptris/yeptris-ts/issues"
  },
  "homepage": "https://github.com/leptris/yeptris-ts#readme"
}
